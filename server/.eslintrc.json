{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": ["airbnb-base", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-plusplus": "off",
    "import/extensions": "off",
    "prefer-destructuring": "off",
    "no-param-reassign": "off",
    "prettier/prettier": ["error"]
  }
}
