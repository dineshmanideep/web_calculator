# Server Environment Variables

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
# Options: development, production
# Use 'production' when deploying

PORT=4000
# Port for the backend server

# ============================================
# DATABASE
# ============================================
MONGO_URI=mongodb://localhost:27017/web_calculator
# For production, use MongoDB Atlas or your hosted MongoDB URL
# Example: mongodb+srv://username:password@cluster.mongodb.net/web_calculator

# ============================================
# SESSION MANAGEMENT
# ============================================
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
# CRITICAL: Generate a strong random secret for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ============================================
# EMAIL CONFIGURATION (NodeMailer)
# ============================================
SMTP_USER=your-email@gmail.com
# Gmail account for sending emails

SMTP_PASS=your-app-specific-password
# Gmail app-specific password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords

FROM_EMAIL=your-email@gmail.com
# Email address shown as sender

# ============================================
# FRONTEND URL (for CORS)
# ============================================
CLIENT_URL=http://localhost:5173
# For production, use your deployed frontend URL
# Example: https://your-app.vercel.app or https://yourdomain.com

# ============================================
# ADDITIONAL SECURITY (Optional but Recommended)
# ============================================
# ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com
# Comma-separated list of allowed origins for CORS

# RATE_LIMIT_WINDOW_MS=900000
# Rate limiting window in milliseconds (default: 15 minutes)

# RATE_LIMIT_MAX_REQUESTS=100
# Max requests per IP within the window (default: 100)

# COOKIE_SECURE=true
# Set to 'true' in production (requires HTTPS)

# TRUST_PROXY=true
# Set to 'true' when behind a reverse proxy (Nginx, Heroku, etc.)
